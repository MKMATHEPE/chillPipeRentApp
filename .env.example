# Server-only configuration. Never commit real keys or passwords.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
ADMIN_USER_ID=verified-owner-user-uuid
ADMIN_EMAIL=owner@example.com
ADMIN_RESET_URL=https://your-app.example/admin-reset
# Store the real value only in ignored .env and as a secret in Sites.
SUPABASE_SECRET_KEY=
CUSTOMER_ACCOUNT_MODE=managed
